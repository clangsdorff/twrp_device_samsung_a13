From b34960df59bcc2362aadb96884fab81f8e1e17fd Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Thu, 24 Sep 2026 21:30:00 +0300
Subject: [PATCH 04/11] minui: render RGBA directly and skip the fbdev powerdown blank

DECON scans fb0 out as RGBA regardless of the reported offsets, so the
RECOVERY_BGRA swap leaves partially redrawn regions swapped. Render RGBA
directly and drop the initial fbdev powerdown blank, which stalls
unblanking for ~10 s on the NVT touch self test.
---

--- a/minuitwrp/graphics_fbdev.cpp
+++ b/minuitwrp/graphics_fbdev.cpp
@@ -209,7 +209,11 @@
     if (vi.bits_per_pixel == 16) {
         printf("setting GGL_PIXEL_FORMAT_RGB_565\n");
         gr_framebuffer[0].format = GGL_PIXEL_FORMAT_RGB_565;
-    } else if (vi.red.offset == 8 || vi.red.offset == 16) {
+    } else if (vi.red.offset == 16) {
+        // DECON scans fb0 out as RGBA whatever offsets it reports
+        printf("setting GGL_PIXEL_FORMAT_RGBA_8888\n");
+        gr_framebuffer[0].format = GGL_PIXEL_FORMAT_RGBA_8888;
+    } else if (vi.red.offset == 8) {
         printf("setting GGL_PIXEL_FORMAT_BGRA_8888\n");
         gr_framebuffer[0].format = GGL_PIXEL_FORMAT_BGRA_8888;
     } else if (vi.red.offset == 0) {
@@ -274,7 +278,8 @@
 
     printf("framebuffer: %d (%d x %d)\n", fb_fd, gr_draw->width, gr_draw->height);
 
-    fbdev_blank(backend, true);
+    // powering the panel down stalls the unblank until the NVT touch self test gives up,
+    // about 10 s; the unblank alone moves DECON out of INIT, where it drops every pan
     fbdev_blank(backend, false);
 
     smem_len = fi.smem_len;
