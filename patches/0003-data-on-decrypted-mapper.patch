Date: Thu, 24 Sep 2026 19:40:20 +0300
Subject: [PATCH 03/11] partition: point /data at the decrypted userdata mapper

Find_Actual_Block_Device resolves /data to the raw userdata partition,
which stays ciphertext under metadata encryption. Once
langsdorff_decrypt creates /dev/block/mapper/userdata, make every mount
of /data use that device.
---

--- a/partition.cpp
+++ b/partition.cpp
@@ -3199,6 +3199,11 @@
 			}
 		}
 		return;
+	} else if (Mount_Point == "/data" && TWFunc::Path_Exists("/dev/block/mapper/userdata")) {
+		// langsdorff_decrypt set up the dm-default-key device; the raw partition is ciphertext
+		Actual_Block_Device = "/dev/block/mapper/userdata";
+		Is_Present = true;
+		return;
 	} else if (Is_Decrypted && !Decrypted_Block_Device.empty()) {
 		Actual_Block_Device = Decrypted_Block_Device;
 		if (TWFunc::Path_Exists(Decrypted_Block_Device)) {
