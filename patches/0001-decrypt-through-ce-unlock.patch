From 7c1f597b28b25c3dbbbc245a505eb0bf503170d5 Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Fri, 2 Oct 2026 00:58:46 +0300
Subject: [PATCH 01/11] gui: pass the decryption credential through the environment

GUIAction::decrypt goes through Decrypt_Device, which falls into the FDE
path here because the 12.1 fscrypt code expects a keymaster 4 HIDL HAL
while the firmware only has KeyMint AIDL. Hand the typed credential to
decrypt_user.sh via TW_CRYPTO_PASSWORD so Exec_Cmd does not log or
display it.
---

--- a/gui/action.cpp
+++ b/gui/action.cpp
@@ -2071,27 +2071,14 @@
 		simulate_progress_bar();
 	} else {
 		string Password;
-		string userID;
 		DataManager::GetValue("tw_crypto_password", Password);
 
-		if (DataManager::GetIntValue(TW_IS_FBE)) {  // for FBE
-			DataManager::GetValue("tw_crypto_user_id", userID);
-			if (userID != "") {
-				op_status = PartitionManager.Decrypt_Device(Password, atoi(userID.c_str()));
-				if (userID != "0") {
-					if (op_status != 0)
-						op_status = 1;
-					operation_end(op_status);
-	          		return 0;
-				}
-			} else {
-				LOGINFO("User ID not found\n");
-				op_status = 1;
-			}
-		::sleep(1);
-		} else {  // for FDE
-			op_status = PartitionManager.Decrypt_Device(Password);
-		}
+		// the firmware security stack performs the unlock; the keymaster 4 path this
+		// tree was built around does not exist on this device. Exec_Cmd logs and shows
+		// the command line, so the credential goes through the environment
+		setenv("TW_CRYPTO_PASSWORD", Password.c_str(), 1);
+		op_status = TWFunc::Exec_Cmd("/system/bin/decrypt_user.sh", true);
+		unsetenv("TW_CRYPTO_PASSWORD");
 
 		if (op_status != 0)
 			op_status = 1;
